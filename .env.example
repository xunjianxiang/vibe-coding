# 必填：Web 与 Runner 共用的 MariaDB 连接地址。
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=

# 必填：SSO Console 分配给本应用的客户端 ID。
# SSO 回调路径固定为 /sso/callback。
SSO_CLIENT_ID=

# 必填：用于加密 SSO Token、签发临时访问票据的明文密钥。
# 无需 Base64 编码；建议使用足够长且不易猜测的字符串。修改后已有登录会话会失效。
SESSION_ENCRYPTION_KEY=

# 以下配置可选，未配置时使用注释中给出的默认值。

# Runner 扫描的项目根目录；相对路径基于应用根目录解析。
# PROJECTS_ROOT=".projects"

# Web 服务监听端口；监听地址固定为 0.0.0.0。
# PORT=3000

