{
  "name": "Vibe Coding Preview Gateway",
  "image": "node:24-bookworm-slim",
  "runArgs": [
    "--network=${localEnv:GATEWAY_NETWORK}",
    "--network-alias=${localEnv:GATEWAY_NETWORK}-gateway",
    "--publish=0.0.0.0:${localEnv:GATEWAY_PORT}:8080"
  ],
  "postCreateCommand": "npm ci --omit=dev",
  "postStartCommand": "start-stop-daemon --start --background --make-pidfile --oknodo --pidfile /tmp/gateway.pid --chdir \"$(pwd)\" --startas /bin/sh -- -c 'exec npm run start </dev/null > /tmp/dev.log 2>&1'",
  "overrideCommand": true,
  "remoteUser": "node",
  "shutdownAction": "stopContainer"
}
