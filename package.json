{
  "name": "vibe-coding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "tsx server.ts --production",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "runner:scan": "tsx runner/index.ts scan",
    "runner:once": "tsx runner/index.ts once",
    "runner:start": "tsx runner/index.ts start",
    "gateway:start": "node --env-file=.env ./node_modules/@devcontainers/cli/devcontainer.js up --workspace-folder gateway --remove-existing-container",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:web": "pm2 start ecosystem.config.cjs --only vibe-coding-web",
    "pm2:start:runner": "pm2 start ecosystem.config.cjs --only vibe-coding-runner",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:restart:web": "pm2 restart vibe-coding-web --update-env",
    "pm2:restart:runner": "pm2 restart vibe-coding-runner --update-env",
    "pm2:stop": "pm2 stop vibe-coding-web vibe-coding-runner"
  },
  "dependencies": {
    "@devcontainers/cli": "0.89.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.22",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "dotenv": "18.0.7",
    "mariadb": "^3.5.4",
    "next": "16.4.0",
    "pm2": "^7.0.4",
    "react": "19.3.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tsx": "^4.20.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.30",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
